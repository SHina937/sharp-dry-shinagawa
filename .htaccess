# ==========================================================================
# シャープドライしながわ .htaccess
# 301リダイレクト（必須。忘れると既存の検索評価を失う）
# TODO: 要確認 — ホスティング先（現行サーバー継続か移行か）。Apache以外の場合は同等のリダイレクト設定に読み替える
# ==========================================================================

<IfModule mod_rewrite.c>
RewriteEngine On

# /index.html → /（301）
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 旧URL → 新URL（301）
RewriteRule ^service\.html$ /service/ [R=301,L]
RewriteRule ^price\.html$ /service/#price [R=301,NE,L]
RewriteRule ^about\.html$ /about/ [R=301,L]
RewriteRule ^contact\.html$ / [R=301,L]
</IfModule>

# 404ページ
ErrorDocument 404 /404.html

# 文字コード
AddDefaultCharset UTF-8
